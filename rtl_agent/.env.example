# LLM 配置模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交）
# OpenAI 兼容接口（DeepSeek 官方 / 阿里云百炼 MaaS / 其它兼容端点均可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
# 主模型：负责 RTL 分析与改写
LLM_MODEL=deepseek-v4.1-flash
# 可选：思考模式（on/off/auto）。默认 off：用"可见的简短分析"代替不可控的隐式推理；auto = 仅救援调用开启
LLM_THINKING=off

# 阿里云百炼示例（使用对应地域/业务空间的密钥）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=deepseek-v4.1-flash
# 每次输出的上限；run.py --max-calls 可限制总逻辑调用数
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90
RTL_AGENT_JOBS=4
